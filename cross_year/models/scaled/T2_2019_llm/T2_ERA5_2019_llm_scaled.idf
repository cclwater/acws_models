! ==================================================================================================
! Literature-based ACWS domain model: T2 - Medium mismatch target domain inspired by Guangzhou commercial-complex ACWS scale
! EnergyPlus target version: 24.2.0-94a887817b
! Location placeholder: Guangzhou, China (23.1291, 113.2644, UTC+8)
! 
! Design basis:
! - Three water-cooled chillers are modeled explicitly.
! - Pumps and cooling towers are represented as aggregate variable-speed plant equipment.
! - S1/S3/T1 are anchored to the published 3-chiller central ACWS case:
!   3 脳 1934 kW chillers, 3 duty chilled-water pumps at 350 m3/h and 37 kW,
!   3 duty condenser-water pumps at 420 m3/h and 90 kW, and 3 cooling towers at 15 kW fan power.
! - S2/T2/T3 are controlled domain perturbations that keep flow and pump/tower parameters in engineering ranges.
! - Replace the Schedule:File CSV with your Meteonorm-derived 8760 h cooling-load file for final experiments.
! ==================================================================================================

Version,24.2;

SimulationControl,
  No,                    !- Do Zone Sizing Calculation
  No,                    !- Do System Sizing Calculation
  No,                    !- Do Plant Sizing Calculation
  No,                    !- Run Simulation for Sizing Periods
  Yes;                   !- Run Simulation for Weather File Run Periods

Building,
  ACWS_T2_MediumMismatchCommercial,
  0.0,                   !- North Axis {deg}
  Suburbs,               !- Terrain
  0.04,                  !- Loads Convergence Tolerance Value {W}
  0.4,                   !- Temperature Convergence Tolerance Value {deltaC}
  FullExterior,          !- Solar Distribution
  25,                    !- Maximum Number of Warmup Days
  6;                     !- Minimum Number of Warmup Days

Timestep,4;

RunPeriod,
  Annual Run,
  1, 1,                  !- Begin Month, Begin Day
  ,                      !- Begin Year
  12, 31,                !- End Month, End Day
  ,                      !- End Year
  Monday,                !- Day of Week for Start Day
  Yes, Yes, No, Yes, Yes;!- Weather/Holiday/Rain/Snow flags

Site:Location,
  Guangzhou_CN_Meteonorm_Placeholder,
  23.1291,                 !- Latitude {deg}
  113.2644,                !- Longitude {deg}
  8.0,                   !- Time Zone {hr}
  21.0;                   !- Elevation {m}

GlobalGeometryRules,
  UpperLeftCorner,
  CounterClockWise,
  Relative;


! --------------------------------------------------------------------------------------------------
! DOMAIN PROFILE SUMMARY
! Domain ID: T2
! Intended role: target
! Reference/anchor: Controlled 3-chiller subset inspired by Guangzhou commercial complex with larger cooling demand and lower effective COP
! Total chiller capacity: 6600.0 kW
! CHW design flow: 0.331782 m3/s; aggregate CHW pump power: 126.3 kW
! CW design flow: 0.398139 m3/s; aggregate CW pump power: 307.1 kW
! Cooling tower aggregate fan power: 60.0 kW
! Placeholder load CSV: T2_acws_load_profile.csv ; replace with Meteonorm/EnergyPlus-derived load for final runs.
! --------------------------------------------------------------------------------------------------

! ==================================================================================================
! SCHEDULES
! ==================================================================================================

ScheduleTypeLimits,
  Any Number;

ScheduleTypeLimits,
  OnOff,
  0,
  1,
  DISCRETE;

Schedule:Compact,
  Always On,
  OnOff,
  THROUGH: 12/31,
  FOR: AllDays,
  UNTIL: 24:00, 1;
Schedule:Compact,
  CHW Supply Temp Setpoint,
